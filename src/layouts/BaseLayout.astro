---
import "../styles/global.css";
import "../styles/landing.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "CarRestyle AI",
  description = "SaaS-платформа для визуализации детейлинга и тюнинга на фото реального автомобиля клиента.",
  canonical = "/",
  ogImage = "/og-image.svg",
  noindex = false
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://carrestyle.ai");
const rawBasePath = import.meta.env.BASE_URL;
const basePath = rawBasePath.endsWith("/") ? rawBasePath : `${rawBasePath}/`;
const siteBaseUrl = new URL(basePath, siteUrl);
const canonicalPath = canonical === "/" ? "" : canonical.replace(/^\//, "");
const assetPath = (path: string) => `${basePath}${path.replace(/^\//, "")}`;
const canonicalUrl = new URL(canonicalPath, siteBaseUrl).toString();
const ogImageUrl = new URL(assetPath(ogImage), siteUrl).toString();
const faviconHref = assetPath("favicon.svg");
const manifestHref = assetPath("site.webmanifest");
const imageAlt = `${title} — превью страницы`;
const robots = noindex
  ? "noindex,nofollow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="manifest" href={manifestHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CarRestyle AI" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript" is:inline>
      (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
      })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=109493205', 'ym');

      ym(109493205, 'init', {ssr:true, webvisor:true, trackHash:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <!-- /Yandex.Metrika counter -->
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/109493205" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>
    <slot />
    <script is:inline>
      (function () {
        const trackedParams = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"];
        const storageKey = "carrestyle_landing_attribution_v1";

        const readStored = () => {
          try {
            return JSON.parse(localStorage.getItem(storageKey) || "{}");
          } catch {
            return {};
          }
        };

        const writeStored = (value) => {
          try {
            localStorage.setItem(storageKey, JSON.stringify(value));
          } catch {}
        };

        const params = new URLSearchParams(window.location.search);
        const payload = {};

        trackedParams.forEach((key) => {
          const value = params.get(key);
          if (value) payload[key] = value.slice(0, 180);
        });

        payload.landing_path = `${window.location.pathname}${window.location.search}`.slice(0, 1000);
        if (document.referrer) payload.referrer = document.referrer.slice(0, 1000);

        const hasUtm = trackedParams.some((key) => payload[key]);
        const stored = readStored();
        const attribution = {
          first: stored.first || payload,
          last: hasUtm ? payload : stored.last || payload
        };

        writeStored(attribution);
        window.__carrestyleAttribution = attribution.last || attribution.first || {};

        const utmParams = new URLSearchParams();
        trackedParams.forEach((key) => {
          const value = window.__carrestyleAttribution[key];
          if (value) utmParams.set(key, value);
        });

        if (!utmParams.toString()) return;

        document.querySelectorAll('a[href*="app.carrestyleai.ru"]').forEach((link) => {
          try {
            const url = new URL(link.href);
            utmParams.forEach((value, key) => url.searchParams.set(key, value));
            link.href = url.toString();
          } catch {}
        });
      })();
    </script>
  </body>
</html>
