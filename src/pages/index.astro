---

<BaseLayout
  title="CarRestyle AI — визуализация стайлинга авто за 20 секунд"
  description="CarRestyle AI помогает студиям показывать клиенту его авто с оклейкой, антихромом или новыми дисками до начала работ: +45% к конверсии и +11% к среднему чеку."
  canonical="/"
>
  <Fragment slot="head">
    <script is:inline>
      (() => {
        const motion = matchMedia("(prefers-reduced-motion: reduce)");
        const root = document.documentElement;

        if (!motion.matches && !location.hash && !scrollY && !document.hidden) {
          const intro = new AbortController();
          const options = { signal: intro.signal };
          root.classList.add("landing-opening");

          function reveal(animate = true) {
            if (!root.classList.contains("landing-opening")) return;
            const stage = document.querySelector(".showroom-film .assembly-film");
            const start = stage?.getBoundingClientRect();
            const transition = animate && !motion.matches && !scrollY && start;
            if (transition) root.classList.add("landing-revealed");
            root.classList.remove("landing-opening");
            if (transition) {
              const end = stage.getBoundingClientRect();
              const offsetX = (start.left + start.width / 2) - (end.left + end.width / 2);
              const offsetY = start.top - end.top;
              const scale = end.width ? start.width / end.width : 1;
              stage.animate([
                { transform: `translate(${offsetX}px, ${offsetY}px) scale(${scale})` },
                { transform: "translate(0, 0) scale(1)" },
              ], { duration: 760, easing: "cubic-bezier(.22,.75,.25,1)" });
            }
            clearTimeout(deadline);
            intro.abort();
          }

          const deadline = setTimeout(reveal, 3800);
          const leave = () => reveal(false);
          document.addEventListener("timeupdate", event => {
            const video = event.target;
            if (video.matches?.(".showroom-film video") && video.currentTime >= .65) reveal();
          }, { ...options, capture: true });
          document.addEventListener("error", event => {
            if (event.target.matches?.(".showroom-film video")) leave();
          }, { ...options, capture: true });
          window.addEventListener("wheel", leave, { ...options, passive: true });
          window.addEventListener("scroll", () => { if (scrollY) leave(); }, { ...options, passive: true });
          window.addEventListener("hashchange", leave, options);
          window.addEventListener("keydown", leave, options);
          document.addEventListener("focusin", leave, options);
          motion.addEventListener("change", leave, options);
        }

        document.addEventListener("DOMContentLoaded", () => {
          if (motion.matches || !("IntersectionObserver" in window)) return;
          const observer = new IntersectionObserver(entries => {
            for (const {target, isIntersecting} of entries) {
              if (!isIntersecting) continue;
              observer.unobserve(target);
              if (!motion.matches && !target.matches(":target, :focus-within") && !target.querySelector(":target")) {
                target.classList.add("section-arrived");
                target.addEventListener("focusin", () => target.classList.remove("section-arrived"), { once: true });
              }
            }
          }, { threshold: 0, rootMargin: "0px 0px -32px" });
          for (const section of document.querySelectorAll(".landing-content > section:not(.showroom), .site-footer")) {
            observer.observe(section);
          }
        }, { once: true });
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

