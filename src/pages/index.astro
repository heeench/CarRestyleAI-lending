---
import BaseLayout from "../layouts/BaseLayout.astro";
import bmwAfterImage from "../assets/bmw-after.jpg";
import bmwBeforeImage from "../assets/bmw-before.jpg";
import carPreviewImage from "../assets/car-preview.png";
import bodyMain from "../assets/surfaces/body_main.png";
import frontBumper from "../assets/surfaces/front_bumper.png";
import frontWheel from "../assets/surfaces/front_wheel.png";
import glass from "../assets/surfaces/glass.png";
import mirror from "../assets/surfaces/mirror.png";
import rearBumper from "../assets/surfaces/rear_bumper.png";
import rearWheel from "../assets/surfaces/rear_wheel.png";
import roofUpperShell from "../assets/surfaces/roof_upper_shell.png";
import sideSkirt from "../assets/surfaces/side_skirt.png";

const benefitCards = [
  {
    number: "01",
    label: "+45%",
    title: "Конверсия растёт",
    text: "Больше консультаций закрываются записью в тот же день."
  },
  {
    number: "02",
    label: "+11%",
    title: "Средний чек выше",
    text: "Клиент видит комплектацию и сам понимает, что стоит добавить."
  },
  {
    number: "03",
    label: "1 экран",
    title: "Предметный диалог без «воды»",
    text: "Один визуал вместо каталога референсов и долгой переписки."
  },
  {
    number: "04",
    label: "Tech",
    title: "Статус студии",
    text: "Вы продаёте не обещание, а результат, который уже виден."
  }
];

const useCases = [
  {
    title: "Оклейка и смена цвета",
    text: "Цвет, матовая или глянцевая плёнка — до предоплаты за материал."
  },
  {
    title: "Антихром и новые диски",
    text: "Shadow Line, чёрные значки, фары и колёса без объяснений на пальцах."
  },
  {
    title: "Комплексный стайлинг",
    text: "Несколько доработок в один образ, чтобы легче согласовать пакет."
  }
];

const decisionStages = [
  {
    index: "01",
    title: "Фото автомобиля",
    text: "Снимок у студии или фото из мессенджера."
  },
  {
    index: "02",
    title: "Выбор зон кузова",
    text: "ИИ находит элементы, вы выбираете зоны."
  },
  {
    index: "03",
    title: "Примерка стилей",
    text: "Цвет, плёнка, антихром, диски — несколько вариантов подряд."
  },
  {
    index: "04",
    title: "Согласование и запись",
    text: "Клиент видит финал, студия фиксирует запись."
  }
];

const spotlightBenefits = [
  "Реальное фото, не 3D-шаблон.",
  "Меняются только выбранные элементы.",
  "Один вариант — до 20 секунд."
];

const heroStats = [
  { label: "Конверсия", value: "+45%" },
  { label: "Средний чек", value: "+11%" }
];

const spotlightSurfaces = [
  { id: "body-main", title: "Основной кузов", url: bodyMain, delay: "0s" },
  { id: "front-bumper", title: "Передний бампер", url: frontBumper, delay: "1.7s" },
  { id: "front-wheel", title: "Переднее колесо", url: frontWheel, delay: "3.4s" },
  { id: "mirror", title: "Зеркало", url: mirror, delay: "5.1s" },
  { id: "roof-shell", title: "Крыша", url: roofUpperShell, delay: "6.8s" },
  { id: "rear-wheel", title: "Заднее колесо", url: rearWheel, delay: "8.5s" },
  { id: "glass", title: "Стекло", url: glass, delay: "10.2s" },
  { id: "rear-bumper", title: "Задний бампер", url: rearBumper, delay: "11.9s" },
  { id: "side-skirt", title: "Порог", url: sideSkirt, delay: "13.6s" }
];

const painQuotes = [
  "«Есть похожие фото, но не мой цвет и не моя модель»",
  "«Хочу сначала увидеть — потом решить»",
  "«Надо посоветоваться / подумаю до завтра»"
];

const testimonials = [
  {
    quote:
      "«Теперь показываем колёса на машине клиента сразу — сомнения снимаются на месте.»",
    author: "ABD Wheels",
    role: "студия дисков и стайлинга"
  },
  {
    quote:
      "«Меньше ситуаций “я подумаю”: люди видят финальный результат и решают быстрее.»",
    author: "Александр",
    role: "руководитель детейлинг-студии «Белая полоса М»"
  },
  {
    quote:
      "«То, что раньше согласовывали перепиской, теперь показываем за 20 секунд на консультации.»",
    author: "Адам",
    role: "владелец студии полного цикла"
  }
];

const pricingPlans = [
  {
    name: "Старт",
    price: "12 000 ₽/мес",
    generations: "200",
    audience: "Небольшие студии, 1–2 менеджера",
    badge: "Для старта",
    features: ["Около 13 клиентских сессий", "Доступ с любого устройства", "Демо на ваших кейсах"],
    featured: false
  },
  {
    name: "Базовый",
    price: "20 000 ₽/мес",
    generations: "400",
    audience: "Средние студии, 3–5 менеджеров",
    badge: "Оптимально",
    features: ["Около 27 клиентских сессий", "Для команды менеджеров", "Больше вариантов на консультацию"],
    featured: true
  },
  {
    name: "Про",
    price: "40 000 ₽/мес",
    generations: "1 200",
    audience: "Крупные студии и сети",
    badge: "Для потока",
    features: ["Около 80 клиентских сессий", "Подходит сетям и филиалам", "Запас генераций для активных продаж"],
    featured: false
  }
];

const faqItems = [
  {
    question: "Нужны ли специальные навыки для работы с сервисом?",
    answer:
      "Нет. Менеджер загружает фото, выбирает зоны и получает визуализацию."
  },
  {
    question: "Что если фото сделано на телефон при плохом освещении?",
    answer:
      "Подходит обычный снимок со смартфона. Лучше всего работает ракурс сбоку или 3/4."
  },
  {
    question: "Сколько генераций уходит на одного клиента?",
    answer:
      "В среднем около 15 генераций на одного клиента: этого хватает, чтобы показать несколько направлений и быстро согласовать финальный вариант."
  },
  {
    question: "Можно ли попробовать до оплаты?",
    answer:
      "Да. Покажем демо на вашем кейсе."
  },
  {
    question: "Вы работаете только в России?",
    answer:
      "Да. Оплата в рублях, поддержка на русском языке."
  }
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CarRestyle AI",
  url: "https://carrestyle.ai",
  logo: "https://carrestyle.ai/favicon.svg",
  email: "hello@carrestyle.ai",
  description: "Платформа для фотореалистичной визуализации оклейки, антихрома и дисков на фото автомобиля клиента.",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "hello@carrestyle.ai",
    availableLanguage: ["ru"]
  }
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CarRestyle AI",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  inLanguage: "ru",
  description:
    "Платформа за 20 секунд генерирует фотореалистичную визуализацию оклейки, антихрома или новых дисков на реальном фото машины клиента.",
  audience: {
    "@type": "Audience",
    audienceType: "Детейлинг-студии, оклейка, антихром, тюнинг-ателье"
  },
  offers: pricingPlans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.price.replace(/\D/g, ""),
    priceCurrency: "RUB",
    description: `${plan.generations} генераций в месяц. ${plan.audience}`
  })),
  publisher: {
    "@type": "Organization",
    name: "CarRestyle AI",
    url: "https://carrestyle.ai"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};
---

<BaseLayout
  title="CarRestyle AI — визуализация стайлинга авто за 20 секунд"
  description="CarRestyle AI помогает студиям показывать клиенту его авто с оклейкой, антихромом или новыми дисками до начала работ: +45% к конверсии и +11% к среднему чеку."
  canonical="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="page-shell" id="top">
    <header class="site-header">
      <a class="brand-mark" href="#top">
        <span class="brand-mark-dot"></span>
        <span>CarRestyle AI</span>
      </a>

      <nav class="site-nav" aria-label="Навигация по лендингу">
        <a href="#spotlight">Демонстрация</a>
        <a href="#benefits">Выгоды</a>
        <a href="#how-it-works">Сценарий</a>
        <a href="#testimonials">Отзывы</a>
        <a href="#pricing">Тарифы</a>
        <a href="#faq">Вопросы</a>
      </nav>

      <a class="button button-primary header-cta" href="#contact">Получить демо</a>
    </header>

    <section class="hero">
      <div class="hero-copy panel">
        <div class="hero-main">
          <h1>Покажите клиенту его авто до начала работ</h1>
          <p class="lead">
            CarRestyle AI за 20 секунд показывает оклейку, антихром или диски
            на реальном фото машины клиента. Меньше «я подумаю», больше записей в день консультации.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#contact">Получить демо-доступ</a>
            <a class="hero-scroll-link" href="#spotlight">Посмотреть, как работает →</a>
          </div>

          <p class="hero-assurance">Демо на вашем кейсе · без установки · доступ с любого устройства</p>
        </div>

        <aside class="hero-proof" aria-label="Ключевые показатели CarRestyle AI">
          <div class="hero-proof-top">
            <div>
              <span>Live demo</span>
              <p>Реальное фото машины клиента → готовый визуал</p>
            </div>
            <strong>20 сек</strong>
          </div>

          <div class="hero-compare-shell">
            <div class="hero-compare-stage" style="--compare-position: 50%;">
              <div class="hero-compare-after-panel">
                <img
                  alt="Автомобиль после визуализации"
                  class="hero-compare-image hero-compare-after-image"
                  decoding="async"
                  fetchpriority="high"
                  src={bmwAfterImage.src}
                />
              </div>
              <div class="hero-compare-before-panel">
                <img
                  alt="Автомобиль до визуализации"
                  class="hero-compare-image hero-compare-before-image"
                  decoding="async"
                  fetchpriority="high"
                  src={bmwBeforeImage.src}
                />
              </div>
              <span class="hero-compare-label hero-compare-label-before">До</span>
              <span class="hero-compare-label hero-compare-label-after">После</span>
              <button class="hero-compare-fullscreen" type="button">Во весь экран</button>
              <span class="hero-compare-handle" aria-hidden="true"><span></span></span>
              <input
                aria-label="Сравнить автомобиль до и после"
                autocomplete="off"
                class="hero-compare-range"
                data-default-value="50"
                max="100"
                min="0"
                type="range"
                value="50"
              />
            </div>
          </div>

          <div class="hero-proof-grid">
            {heroStats.map((item) => (
              <div>
                <span>{item.label}</span>
                <strong>{item.value}</strong>
              </div>
            ))}
          </div>

          <div class="hero-proof-flow" aria-label="Процесс демонстрации">
            <span>Фото</span>
            <span>Зоны</span>
            <span>Стиль</span>
            <span>Запись</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="pain-section panel">
      <div class="pain-copy">
        <p class="eyebrow">Знакомая ситуация?</p>
        <h2>Клиент попросил время подумать и не вернулся?</h2>
        <p>
          Каталог и референсы не отвечают на главный вопрос: как это будет выглядеть
          на моей машине?
        </p>
      </div>

      <div class="pain-quotes" aria-label="Типичные возражения клиентов">
        {painQuotes.map((quote, index) => (
          <p>
            <span>{String(index + 1).padStart(2, "0")}</span>
            {quote}
          </p>
        ))}
      </div>

      <p class="pain-transition">
        CarRestyle AI убирает неопределённость до договора.
      </p>
    </section>

    <section class="spotlight-section panel" id="spotlight">
      <div class="spotlight-copy">
        <p class="eyebrow">Как это выглядит</p>
        <h2>Фокус на визуал: стиль сразу на авто клиента</h2>
        <p>
          Смотрите на подсветку зон: сервис меняет только выбранные элементы,
          сохраняя реальное фото автомобиля.
        </p>

        <ul class="benefit-list">
          {spotlightBenefits.map((benefit) => (
            <li>{benefit}</li>
          ))}
        </ul>
      </div>

      <div class="spotlight-stage-wrap">
        <div class="car-spotlight-shell" aria-label="Анимация подсветки деталей автомобиля">
          <div class="car-spotlight-copy">
            <span class="chip-label">Генерация — до 20 секунд</span>
            <strong class="chip-value">Кузов · диски · детали</strong>
            <span class="chip-subvalue">подсветка выбранных зон</span>
          </div>

          <div class="car-spotlight-host">
            <div class="car-spotlight-aura car-spotlight-aura-left"></div>
            <div class="car-spotlight-aura car-spotlight-aura-right"></div>

            <div class="car-spotlight-stage">
              <img
                alt="Контур автомобиля для визуализации"
                class="car-spotlight-preview-image"
                decoding="async"
                loading="lazy"
                src={carPreviewImage.src}
              />

              {spotlightSurfaces.map((surface) => (
                <span
                  aria-hidden="true"
                  class="car-spotlight-surface-layer"
                  style={`--surface-url: url(${surface.url.src}); --surface-delay: ${surface.delay};`}
                >
                  <img
                    alt=""
                    class="car-spotlight-surface-outline"
                    decoding="async"
                    loading="lazy"
                    src={surface.url.src}
                  />
                  <span class="car-spotlight-surface-fill"></span>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-block" id="benefits">
      <div class="section-heading">
        <p class="eyebrow">Зачем это бизнесу</p>
        <h2>CarRestyle AI превращает сомнения клиента в уверенное «Делаем!»</h2>
      </div>

      <div class="card-grid card-grid-four">
        {benefitCards.map((item) => (
          <article class="value-card panel">
            <div class="value-card-head">
              <span class="value-number">{item.number}</span>
              <strong>{item.label}</strong>
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="use-cases section-block">
      <div class="section-heading">
        <p class="eyebrow">Идеально для ключевых услуг</p>
        <h2>Помогаем продавать там, где результат нужно увидеть заранее</h2>
      </div>

      <div class="card-grid card-grid-three">
        {useCases.map((item) => (
          <article class="info-card panel">
            <span class="service-mark" aria-hidden="true"></span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="decision-flow panel" id="how-it-works">
      <div class="decision-flow-copy">
        <p class="eyebrow">Простой процесс работы</p>
        <h2>4 шага от фотографии до закрытой сделки</h2>
        <p>
          Без Photoshop и сложного софта. Всё укладывается в консультацию.
        </p>
      </div>

      <div class="decision-rail" aria-label="Сценарий работы с CarRestyle AI">
        {decisionStages.map((stage) => (
          <article class="decision-stage">
            <span class="decision-node" aria-hidden="true"></span>
            <span class="decision-index">{stage.index}</span>
            <h3>{stage.title}</h3>
            <p>{stage.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="testimonials-section section-block" id="testimonials">
      <div class="section-heading">
        <p class="eyebrow">Говорят студии-участники пилота</p>
        <h2>Что изменилось после первого месяца</h2>
      </div>

      <div class="card-grid card-grid-three">
        {testimonials.map((item) => (
          <article class="testimonial-card panel">
            <blockquote>{item.quote}</blockquote>
            <div class="testimonial-author">
              <span aria-hidden="true">{item.author.slice(0, 1)}</span>
              <p>
                <strong>{item.author}</strong>
                <small>{item.role}</small>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="pricing-section panel" id="pricing">
      <div class="section-heading">
        <p class="eyebrow">Прозрачное ценообразование</p>
        <h2>Выберите план под размер вашей студии</h2>
      </div>

      <div class="pricing-grid" aria-label="Тарифы CarRestyle AI">
        {pricingPlans.map((plan) => (
          <article class={`pricing-card${plan.featured ? " is-featured" : ""}`}>
            <div class="pricing-card-head">
              <span>{plan.badge}</span>
              <h3>{plan.name}</h3>
            </div>
            <strong>{plan.price}</strong>
            <p>{plan.generations} генераций в месяц</p>
            <span>{plan.audience}</span>
            <ul>
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <a class="button button-secondary pricing-cta" href="#contact">Выбрать план</a>
          </article>
        ))}
      </div>

      <p class="pricing-note">
        Генерация до 20 секунд. Доступ с любого устройства. Оплата в рублях.
      </p>
    </section>

    <section class="faq-section section-block" id="faq">
      <div class="section-heading">
        <p class="eyebrow">Частые вопросы</p>
        <h2>Отвечаем на главные вопросы</h2>
      </div>

      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="contact panel" id="contact">
      <div class="contact-copy">
        <p class="eyebrow">Получить демонстрацию</p>
        <h2>Готовы продавать стайлинг по-новому?</h2>
        <p>
          Покажем сервис на ваших проектах и дадим доступ к платформе.
        </p>

        <div class="contact-benefits">
          <span>Демо на ваших проектах</span>
          <span>Генерация до 20 сек</span>
          <span>Оплата в рублях</span>
        </div>

        <div class="contact-route">
          <strong>Что будет после заявки</strong>
          <p>Возьмём один кейс и пройдём сценарий реальной консультации.</p>
        </div>
      </div>

      <form
        class="lead-form"
        action="mailto:hello@carrestyle.ai?subject=Запрос%20демонстрации%20CarRestyle%20AI"
        enctype="text/plain"
        method="post"
      >
        <label class="lead-field">
          <span>Имя</span>
          <input autocomplete="name" name="Имя" placeholder="Как к вам обращаться" required type="text" />
        </label>

        <label class="lead-field">
          <span>Студия</span>
          <input autocomplete="organization" name="Студия" placeholder="Название студии" type="text" />
        </label>

        <label class="lead-field">
          <span>Контакт</span>
          <input autocomplete="email" name="Контакт" placeholder="Почта, телефон или Telegram" required type="text" />
        </label>

        <label class="lead-field lead-field-full">
          <span>Что вы хотите показывать клиентам</span>
          <textarea
            name="Сценарий"
            placeholder="Например: оклейка, антихром, цвет, диски, тюнинг"
            rows="4"
          ></textarea>
        </label>

        <label class="lead-consent lead-field-full">
          <input name="Согласие" required type="checkbox" value="Принято" />
          <span>
            Я принимаю <a href="/user-agreement/" target="_blank" rel="noopener">пользовательское соглашение</a> и
            даю согласие на обработку персональных данных для связи по заявке.
          </span>
        </label>

        <button class="button button-primary lead-submit" type="submit">
          Получить демо-доступ
        </button>

        <p class="lead-note">
          После отправки откроется письмо с заявкой. Или напишите напрямую на{" "}
          <a href="mailto:hello@carrestyle.ai">hello@carrestyle.ai</a>
        </p>
      </form>
    </section>

    <footer class="site-footer">
      <p>© 2026 CarRestyle AI — визуализация детейлинга и тюнинга на фото автомобиля клиента.</p>
      <div class="site-footer-links">
        <a href="/user-agreement/">Пользовательское соглашение</a>
        <a href="mailto:hello@carrestyle.ai">hello@carrestyle.ai</a>
      </div>
    </footer>

    <div class="mobile-sticky-cta">
      <a class="button button-primary" href="#contact">Получить демо</a>
    </div>
  </main>

  <dialog class="compare-dialog" aria-label="Сравнение автомобиля до и после во весь экран">
    <div class="compare-dialog-shell">
      <div class="compare-dialog-head">
        <span>До / После</span>
        <button class="compare-dialog-close" type="button" aria-label="Закрыть полноэкранное сравнение">
          Закрыть
        </button>
      </div>

      <div class="hero-compare-shell compare-dialog-frame">
        <div class="hero-compare-stage" style="--compare-position: 50%;">
          <div class="hero-compare-after-panel">
            <img
              alt="Автомобиль после визуализации"
              class="hero-compare-image hero-compare-after-image"
              decoding="async"
              src={bmwAfterImage.src}
            />
          </div>
          <div class="hero-compare-before-panel">
            <img
              alt="Автомобиль до визуализации"
              class="hero-compare-image hero-compare-before-image"
              decoding="async"
              src={bmwBeforeImage.src}
            />
          </div>
          <span class="hero-compare-label hero-compare-label-before">До</span>
          <span class="hero-compare-label hero-compare-label-after">После</span>
          <span class="hero-compare-handle" aria-hidden="true"><span></span></span>
          <input
            aria-label="Сравнить автомобиль до и после во весь экран"
            autocomplete="off"
            class="hero-compare-range"
            data-default-value="50"
            max="100"
            min="0"
            type="range"
            value="50"
          />
        </div>
      </div>
    </div>
  </dialog>

  <script is:inline>
    const initCompareStage = (stage) => {
      const range = stage.querySelector(".hero-compare-range");
      if (!(range instanceof HTMLInputElement)) return;
      range.value = range.dataset.defaultValue || "50";

      const updateCompare = () => {
        stage.style.setProperty("--compare-position", `${range.value}%`);
      };

      updateCompare();
      range.addEventListener("input", updateCompare);
    };

    document.querySelectorAll(".hero-compare-stage").forEach(initCompareStage);

    const compareDialog = document.querySelector(".compare-dialog");
    const openCompareDialog = document.querySelector(".hero-compare-fullscreen");
    const closeCompareDialog = document.querySelector(".compare-dialog-close");

    openCompareDialog?.addEventListener("click", () => {
      if (compareDialog instanceof HTMLDialogElement) {
        compareDialog.showModal();
      }
    });

    closeCompareDialog?.addEventListener("click", () => {
      if (compareDialog instanceof HTMLDialogElement) {
        compareDialog.close();
      }
    });

    compareDialog?.addEventListener("click", (event) => {
      if (event.target === compareDialog && compareDialog instanceof HTMLDialogElement) {
        compareDialog.close();
      }
    });
  </script>
</BaseLayout>
