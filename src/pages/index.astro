        <a href="#benefits">Выгоды</a>
        <a href="#how-it-works">Сценарий</a>
        <a href="#testimonials">Отзывы</a>
        <a href="#pricing">Тарифы</a>
        <a href="#faq">Вопросы</a>
      </nav>

      <a class="button button-secondary header-cta" href="https://app.carrestyleai.ru/">Открыть студию <span aria-hidden="true">↗</span></a>
    </header>

    <main class="landing-content" id="main-content" tabindex="-1">
      <section class="showroom" aria-labelledby="showroom-title">
